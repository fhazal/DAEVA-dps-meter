{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daeva Meter",
  "version": "0.5.2",
  "identifier": "org.bajubesi.daevameter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Daeva Meter",
        "url": "index.html",
        "width": 380,
        "height": 320,
        "minWidth": 260,
        "minHeight": 60,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5QzI3QTNCNjk2RTEzOTkKUldTWkUyNXBPM3JDZVIyMVNXdEZ6S1c0ZGt4b2lEcUNROFA3cVh2LzRJeHB5MkIxZzdQaFdIU1EK",
      "endpoints": ["https://github.com/fhazal/DAEVA-dps-meter/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BajuBesi Labs",
    "shortDescription": "AION 2 damage meter",
    "longDescription": "Open, passive damage meter for AION 2. Reads game traffic via Npcap; never touches the game client.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../definitions/aion2.json": "definitions/aion2.json",
      "../../definitions/names.json": "definitions/names.json",
      "../../definitions/a2tools/names.json": "definitions/a2tools/names.json",
      "../../definitions/a2tools/LICENSE": "definitions/a2tools/LICENSE",
      "../../definitions/aion2gg/boss-fights.json": "definitions/aion2gg/boss-fights.json",
      "../../definitions/aion2gg/boss-skills.json": "definitions/aion2gg/boss-skills.json",
      "../../definitions/aion2gg/README.md": "definitions/aion2gg/README.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      }
    }
  }
}
