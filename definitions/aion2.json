    //   "fields": ["src:varint", "tgt:varint", "skill:u32", "count:u8",
    //     {"name": "hits", "type": "repeat", "count": "count",
    //      "fields": ["dmg:varint", "flags:u16le"]}],
    //   "emit": {"event": "damage", "each": "hits", "src": "src", "tgt": "tgt",
    //            "skill": "skill", "amount": "dmg", "crit": "flags&0x1", "back": "flags&0x4"}
    // }
  ]
}
