// AION 2 protocol definitions for Daeva Meter.
//
// STATUS: framing and messages are NOT decoded yet. Fill this in from
// research captures (see docs/DECODING.md). The meter reloads this file
// from %APPDATA%\org.bajubesi.daevameter\definitions\ if present, so
// updates after a game patch never need a new build.
{
  "name": "AION 2 (global)",
  "version": "0.6.36",
  "process_names": ["aion2"],
  // Server ports, if they turn out to be fixed. Auto-detection by process
  // already finds the server, so this can stay empty.
  "ports": [],
  "framing": {
    // Observed 2026-10-17 (Shulak cave capture): each message is
    // <varint length><u16le opcode><body>, and body = length - 6 bytes
    // (whatever the varint's own size). e.g. "0e 00 36 aa 21 fd 47 a1 01 00 00".
    "header": ["length:varint", "opcode:u16le"],
    "length_counts": "payload",
    "length_adjust": -6,
    "min_frame": 3,
    "max_frame": 1048576,
    "compression": "lz4"
  },
  "messages": [
    // Bundle of LZ4-compressed frames: u32le decompressed size + LZ4 block.
    {"opcode": "0xffff", "name": "S_BUNDLE_LZ4", "dir": "any", "container": true, "decompress": true},
    // Skill/attack result, one frame per hit (decoded 2026-10-17 from
    // Shulak / Cave Drana captures).
    //   flags&0x4  = carries damage      flags&0x2 = 3-byte x0/x1/x2 block
    //   flags&0x20 = multi-hit: u8 count of sub-hits (+ their split values);
    //                verified vs Abyss: Onslaught 2 results x 3 = 6 hits
    //   kind==3    = critical hit                       (verified)
    //   x0&0x8     = double (~2x)                        (verified, marker "back double")
    //   x0&0x4     = perfect (small bonus)               (verified, marker "front perfect")
    //   x2         = direction: 2 = front, 1 = back      (verified, markers)
    //   x0&0x2     = parried   (verified: 7 exact values, e.g. "Parry + 798")
    //   x0&0x1     = blocked   (verified: "Block+309", "Block+3", "Block + 32")
    //   x0&0x40    = perfect parry/block (markers); 0x10/0x20 not yet known
    //   seq        = cast id (several results share it)
    //   unk        = a varint, not a u16: 3 bytes for some players (2026-10-29,
    //                Urugugu: their hits read as 1 damage, bosses 93-97% counted)
    {"opcode": "0x3804", "name": "S_SKILL_RESULT", "dir": "server",
     "fields": [
       "tgt:varint", "flags:u16le", "src:varint", "skill:u32le", "seq:u8", "kind:u8",
       {"name": "x0", "type": "u8", "if": "flags&0x2"},
       {"name": "x1", "type": "u8", "if": "flags&0x2"},
       {"name": "x2", "type": "u8", "if": "flags&0x2"},
       "hit_id:u32le", "hit_idx:u32le", "unk:varint",
       {"name": "dmg", "type": "varint", "if": "flags&0x4"},
       {"name": "multi", "type": "u8", "if": "flags&0x20"}
     ],
     "emit": [
       {"event": "damage", "when": "flags&0x4", "src": "src", "tgt": "tgt",
        "skill": "skill", "amount": "dmg",
        "crit": "kind==3", "double": "x0&0x8", "perfect": "x0&0x4",
        "front": "x2==2", "back": "x2==1", "multi": "multi", "cast": "seq",
        "parry": "x0&0x2", "block": "x0&0x1", "perfect_block": "x0&0x40",
        // flags&0x2 = an attack (hit block present). Party heals and buffs
        // also come as skill results with an amount, never with it.
        "aimed": "flags&0x2"},
       // Player class skills have 8-digit ids (18xxxxxx); monster skills are
       // 7-digit. This tells players and mobs apart when neither has been
       // seen spawning. "skill+6777216>>24" is non-zero exactly when
       // skill >= 10,000,000 (written this way so older meter builds parse it).
       {"event": "actor", "when": "skill+6777216>>24", "id": "src", "kind": "'player'"},
       {"event": "actor", "when": "skill+6777216>>24==0", "id": "src", "kind": "'npc'"}
     ]},
    // Effect/debuff applied: carries the caster's name and legion.
    {"opcode": "0x8d04", "name": "S_EFFECT_CASTER_INFO", "dir": "server",
     "fields": ["tgt:varint", "skill:u32le", "src:varint", "server:u16le", "name:str", "legion:str"],
     "emit": [
       {"event": "actor", "id": "src", "name": "name", "kind": "'player'"},
       // The caster's game server (world) number; your own one names your server.
       {"event": "actor_server", "id": "src", "server": "server"}
     ]},
    // Only ever sent about the local player.
    {"opcode": "0x364a", "name": "S_SELF_STATE", "dir": "server",
     "fields": ["id:varint"],
     "emit": {"event": "self", "id": "id"}},
    // Your full character info, sent once per zone load (login, teleport,
    // dungeon entry; the entity id can stay the same across a teleport).
    // id, 5 unknown bytes, your name, your server number, a u32, your
    // faction (race 1 = Elyos, 2 = Asmodian, as in 0x3645).
    {"opcode": "0x3633", "name": "S_SELF_INFO", "dir": "server",
     "fields": ["id:varint", "x:skip5", "name:str", "server:u16le", "u1:u32le", "race:u8"],
     "emit": [
       {"event": "self", "id": "id", "name": "name"},
       {"event": "actor_server", "id": "id", "server": "server"},
       {"event": "actor_race", "id": "id", "race": "race"},
       {"event": "fresh"}
     ]},
    // Entity spawn. b is a flag set: bit 0x20 = NPC/monster with template id,
    // position, HP (seen as 32, 44 and 48; 48 = 0x20|0x10 has different
    // fields after the heading, so HP is only read for 32 and 44).
    // b==256 (0x100): player-owned object/summon, followed by the owner's name.
    {"opcode": "0x3641", "name": "S_SPAWN", "dir": "server",
     "fields": ["id:varint", "a:u8", "b:u16le",
                {"name": "npc", "type": "u32le", "if": "b&48"},
                {"name": "npc0", "type": "u32le", "if": "b==0"},
                {"name": "c", "type": "u8", "if": "b&32"},
                {"name": "d", "type": "u8", "if": "b&32"},
                {"name": "x", "type": "f32le", "if": "b&32"},
                {"name": "y", "type": "f32le", "if": "b&32"},
                {"name": "z", "type": "f32le", "if": "b&32"},
                {"name": "heading", "type": "f32le", "if": "b&32"},
                {"name": "unk", "type": "varint", "if": "b&32"},
                {"name": "hp", "type": "varint", "if": "b&32"},
                {"name": "max_hp", "type": "varint", "if": "b&32"},
                {"name": "pname", "type": "str", "if": "b==256"},
                // Summoned spirits (b==16): after eight ff bytes and an 8-byte
                // stamp comes the summoner's entity id.
                {"name": "m16", "type": "seek", "pattern": "ff ff ff ff ff ff ff ff", "if": "b==16&&a!=28"},
                {"name": "s16", "type": "skip", "len": 16, "if": "b==16&&a!=28"},
                {"name": "owner", "type": "varint", "if": "b==16&&a!=28"},
                // a==28: an object placed by a monster (e.g. Faithful Rajit's
                // Recovery Totem, 2920205). Its owner is the u32 just before
                // "00 2d 00 00 00" near the end; the varint above would be the
                // object's own id, which made it show as a damage dealer.
                {"name": "m28", "type": "seek", "pattern": "00 2d 00 00 00", "back": 4, "if": "b==16&&a==28"},
                {"name": "owner28", "type": "u32le", "if": "b==16&&a==28"},
                // Skill objects (b==0) carry their summoner's name after
                // "06 00 00 00 00 00" and the summoner's server number.
                {"name": "m0", "type": "seek", "pattern": "06 00 00 00 00 00", "optional": true, "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000"},
                {"name": "s0", "type": "skip", "len": 8, "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0"},
                {"name": "oname", "type": "str", "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0"},
                // Some carry the caster's entity id instead, like a==31 below
                // (a==95 Sorcerer ground skills in the Beritra air raid). The
                // name seek used to fail the whole spawn, so each cast showed
                // as its own "Player #12345" row.
                {"name": "m95", "type": "seek", "pattern": "07 02 06", "optional": true, "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0==0"},
                {"name": "s95", "type": "skip", "len": 3, "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0==0&&m95"},
                {"name": "owner95", "type": "u32le", "if": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0==0&&m95"},
                // a==31: ground skills such as a Sorcerer's Bittercold Wind,
                // Fire Wall and Cold Storm. No name; the caster's entity id is
                // the u32 after "07 02 06" near the end. Without it each cast
                // showed as its own "Player #12345" row.
                {"name": "m31", "type": "seek", "pattern": "07 02 06", "if": "b==0&&a==31&&npc0>2000000&&npc0<3000000"},
                {"name": "s31", "type": "skip", "len": 3, "if": "b==0&&a==31&&npc0>2000000&&npc0<3000000"},
                {"name": "owner31", "type": "u32le", "if": "b==0&&a==31&&npc0>2000000&&npc0<3000000"}],
     "emit": [
       // Every monster spawn names its template (fixes "Mob #12345").
       {"event": "actor", "when": "b&32", "id": "id", "kind": "'npc'", "npc_id": "npc"},
       // b==16: a player's spirit/pet/object (templates 292xxxx, e.g. an
       // Elementalist spirit). Name it from its template, not "Player #12345".
       {"event": "actor", "when": "b==16&&a!=28", "id": "id", "kind": "'summon'", "npc_id": "npc", "owner": "owner"},
       {"event": "actor", "when": "b==16&&a==28", "id": "id", "kind": "'summon'", "npc_id": "npc", "owner": "owner28"},
       // b==0 (a=95): skill objects such as Sorcerer summons, same idea.
       {"event": "actor", "when": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0", "id": "id", "kind": "'summon'", "npc_id": "npc0", "name": "oname"},
       {"event": "actor", "when": "b==0&&a!=31&&npc0>2000000&&npc0<3000000&&m0==0&&owner95>0", "id": "id", "kind": "'summon'", "npc_id": "npc0", "owner": "owner95"},
       {"event": "actor", "when": "b==0&&a==31&&npc0>2000000&&npc0<3000000&&owner31>0", "id": "id", "kind": "'summon'", "npc_id": "npc0", "owner": "owner31"},
       // a==28 with no owner and an open-world monster id (24xxxxx): a
       // monster hatched from an egg, e.g. the Giant Ore Insectoid (2400456)
       // or the Contaminated Swarm (2400085). Short spawn, no HP; named from
       // its id (user reports 1793397926, 1793677556: "Unknown monster").
       // Ground effects and traps (a==28, 292xxxx) stay unnamed objects.
       {"event": "actor", "when": "b==0&&a==28&&npc0>2399999&&npc0<2500000&&m0==0&&m95==0", "id": "id", "kind": "'npc'", "npc_id": "npc0"},
       // Max HP only where the layout is verified. The spawn's own "hp" field
       // is not current HP (e.g. 196 of 270000), so a new monster starts full;
       // 0x8d00 updates take over from the first hit.
       {"event": "actor", "when": "b==32&&max_hp>1", "id": "id", "kind": "'npc'", "npc_id": "npc", "max_hp": "max_hp"},
       {"event": "actor", "when": "b==44&&max_hp>1", "id": "id", "kind": "'npc'", "npc_id": "npc", "max_hp": "max_hp"},
       {"event": "hp", "when": "b==32&&max_hp>1", "id": "id", "hp": "max_hp", "max_hp": "max_hp"},
       {"event": "hp", "when": "b==44&&max_hp>1", "id": "id", "hp": "max_hp", "max_hp": "max_hp"},
       // b==256 is an object/summon carrying its owner's name (e.g. Templar
       // Divine Aura); its damage is credited to that owner. Real players
       // arrive via 0x3645.
       {"event": "actor", "when": "b==256", "id": "id", "kind": "'summon'", "name": "pname"}
     ]},
    // Full player info when another player comes into view (party members on
    // dungeon entry): id, 5 header bytes, name, a u32, faction (race 1 =
    // Elyos, 2 = Asmodian: the official race id; verified 2026-10-29 on 26
    // enemies vs 184 allies at the Abyss and Watcher Kaira).
    {"opcode": "0x3645", "name": "S_PLAYER_INFO", "dir": "server",
     "fields": ["id:varint", "p1:u8", "p2:u8", "p3:varint", "p4:u8", "name:str", "u1:u32le", "race:u8"],
     "emit": [
       {"event": "actor", "id": "id", "kind": "'player'", "name": "name"},
       {"event": "actor_race", "id": "id", "race": "race"}
     ]},
    // Periodic ticks: kind 10 = damage over time, kind 9 = heal over time
    // (kinds 11/48 are other resources). Abyss lists these as "(DOT)".
    // A player's own damage over time has a 10-digit effect id built from
    // the skill (17080240 -> 1708024011). Shorter effect ids are monster
    // effects: their damage on players counts as damage taken, but on a boss
    // they are mechanics (Thamon heals himself whenever he's hit, reported
    // here with the attacker's skill), never player damage: npc_only.
    {"opcode": "0x3805", "name": "S_PERIODIC", "dir": "server",
     "fields": ["tgt:varint", "kind:u8", "src:varint", "tick:varint", "effect:u32le", "amount:varint", "skill:u32le"],
     "emit": [
       {"event": "damage", "when": "kind==10&&effect>=1000000000", "src": "src", "tgt": "tgt", "skill": "skill", "amount": "amount", "dot": 1},
       {"event": "damage", "when": "kind==10&&effect<1000000000", "src": "src", "tgt": "tgt", "skill": "skill", "amount": "amount", "dot": 1, "npc_only": 1},
       {"event": "heal", "when": "kind==9", "src": "src", "tgt": "tgt", "skill": "skill", "amount": "amount", "dot": 1}
     ]},
    // Local player's combat power (sent on its own, no entity id).
    {"opcode": "0x3656", "name": "S_SELF_CP", "dir": "server",
     "fields": ["cp:u64le", "cp2:u64le"],
     "emit": {"event": "self_stats", "cp": "cp"}},
    // Account counter update. kind 1 + tag 51591 = Odyle: flag 4 carries the
    // base amount, flag 8 the bonus shown as "(+N)". The 840 cap is fixed.
    {"opcode": "0x610c", "name": "S_COUNTER_UPDATE", "dir": "server",
     // tag is 3 bytes (51591 = 87 93 03 is Odyle; 00 00 00 with kind 1 is
     // the Shugo Festival Reward Key count).
     "fields": ["x:u8", "flags:u8", "kind:u8", "t0:u8", "t1:u8", "t2:u8",
                {"name": "cur", "type": "varint", "if": "flags&4"},
                {"name": "bonus", "type": "varint", "if": "flags&8"}],
     "emit": [
       {"event": "odyle", "when": "kind==1&&t0==135&&t1==147&&t2==3", "cur": "cur", "bonus": "bonus"},
       // No flag 4 = 0 keys left (the game leaves zeros out, as for Odyle).
       // Flag 8 = keys claimed above the 21 limit, the game's "0 (+3)"
       // (shugoextrakey-060-001 t=275.5: "08 01 00 00 00 02" = 0 (+2)).
       {"event": "keys", "when": "kind==1&&t0==0&&t1==0&&t2==0", "cur": "cur", "bonus": "bonus", "which": "1"},
       // kind 8 = Dimensional Invasion keys (1 -> 0 as the last one was used,
       // petfarm-test1-060-002 t=171).
       {"event": "keys", "when": "kind==8&&t0==0&&t1==0&&t2==0", "cur": "cur", "which": "8"}
     ]},
    // Full counter list sent at login: a count, then entries of flags,
    // kind, 3-byte tag, values. The first entry is the Shugo key count
    // (flag 8: the claimed keys above the limit, as in 0x610c);
    // then jump to the Dimensional Invasion keys (kind 8, tag 00 00 00:
    // "04 08 00 00 00 01" = 1 key, report 1793586112), then to the Odyle
    // entry (kind 1, tag 87 93 03).
    {"opcode": "0x610b", "name": "S_COUNTER_LIST", "dir": "server",
     "fields": ["n:u8", "kf:u8", "kk:u8", "k0:u8", "k1:u8", "k2:u8",
                {"name": "keys", "type": "varint", "if": "kf&4"},
                {"name": "kbonus", "type": "varint", "if": "kf&8"},
                {"name": "dat", "type": "seek", "pattern": "08 00 00 00", "back": 1, "optional": true},
                {"name": "df", "type": "u8", "if": "dat"}, {"name": "dk", "type": "u8", "if": "dat"}, {"name": "dtag", "type": "skip", "len": 3, "if": "dat"},
                {"name": "dkeys", "type": "varint", "if": "df&4"},
                {"name": "at", "type": "seek", "pattern": "01 87 93 03", "back": 1},
                "flags:u8", "kind:u8", "t0:u8", "t1:u8", "t2:u8",
                {"name": "cur", "type": "varint", "if": "flags&4"},
                {"name": "bonus", "type": "varint", "if": "flags&8"}],
     "emit": [
       {"event": "keys", "when": "kk==1&&k0==0&&k1==0&&k2==0", "cur": "keys", "bonus": "kbonus", "which": "1"},
       {"event": "keys", "when": "dat&&dk==8", "cur": "dkeys", "which": "8"},
       {"event": "odyle", "when": "kind==1&&t0==135&&t1==147&&t2==3", "cur": "cur", "bonus": "bonus"},
       // Sent on login: everything around you is being introduced.
       {"event": "fresh", "when": "1"}
     ]},
    // Group (party) list, resent every few seconds: member entries with an
    // account id, server and name. Used for "Me and my party".
    {"opcode": "0x9702", "name": "S_PARTY_LIST", "dir": "server",
     "fields": [{"name": "members", "type": "member_names", "marker": 30}],
     "emit": {"event": "party", "when": "1", "members": "members"}},
    // Party list sent when you join any party (open world too, where 0x9702
    // never comes): the same member entries without the marker byte.
    {"opcode": "0x9200", "name": "S_PARTY_INFO", "dir": "server",
     "fields": [{"name": "members", "type": "member_names", "marker": 0}],
     "emit": {"event": "party", "when": "1", "members": "members"}},
    // Someone accepted your invite (open world): a short header, then one
    // entry as in 0x9200. Your own 0x9200 before it lists just you
    // (report 1792829501, 141-147 s).
    {"opcode": "0x920d", "name": "S_PARTY_JOINED", "dir": "server",
     "fields": [{"name": "members", "type": "member_names", "marker": 0}],
     "emit": {"event": "party_join", "when": "1", "members": "members"}},
    // Pet list, sent at login only (not on teleport or opening the Pets
    // window): u32, then each owned pet (pet id twice, level 1-3), then
    // each pet's kills towards its next level (a pet with 1-4 kills and no
    // level isn't unlocked yet; a pet left out has 0). More data follows
    // (not read). Pet ids are the game's own (Kerubian = 1170), not monster
    // ids (petfarm-059-001, 2026-11-02).
    {"opcode": "0x9000", "name": "S_PET_LIST", "dir": "server", "sync": false,
     "fields": ["x:u32le", "n:varint",
                {"name": "levels", "type": "repeat", "count": "n", "fields": ["pet:u32le", "pet2:u32le", "level:u32le"]},
                "m:varint",
                {"name": "counts", "type": "repeat", "count": "m", "fields": ["pet:u32le", "count:u32le"]}],
     "emit": [
       {"event": "pets_reset", "when": "1"},
       {"event": "pet", "each": "levels", "when": "1", "pet": "pet", "level": "level"},
       {"event": "pet", "each": "counts", "when": "1", "pet": "pet", "count": "count"}
     ]},
    // Kills counted for pets: how many pets, then each pet id and its +n.
    // Usually one (matched the other meter's "Kerubian 13/25 +1",
    // petfarm-059-001 t=303.2); two monsters of different pets dying
    // together come as one message with two (dunegon-test7-001: Kailin and
    // Young Kailin levelled at 21/25 and 22/25 while these were skipped).
    {"opcode": "0x900d", "name": "S_PET_GAIN", "dir": "server", "sync": false,
     "fields": ["x:u8", {"name": "gains", "type": "repeat", "count": "x", "fields": ["pet:u32le", "n:u32le"]}],
     "emit": {"event": "pet", "each": "gains", "when": "1", "pet": "pet", "gain": "n"}},
    // A kill of a monster whose pet is maxed dropped Insight crystals
    // (not every kill does): how many drops (1), colour (1 Fera, 2 Cogni, 3 Natura,
    // 4 Varian), amount (2 when two died at once), 02. No pet id
    // (petfarm-test2-001: 46 Cogni, petfarm-test4-001: 31 Fera,
    // petfarm-test4-003: 24 Natura, r1792660621: Varian, each right after
    // such a kill). Colour 6 comes alone, 10-1000 at once, with no kill
    // before it (Special crystals come from Hidden Cubes, maybe that).
    // Two monsters of different families dropping at once come as one
    // message: 02, colour, amount, colour, amount, 02 (petfarm-test7-001
    // t=4.6: Natura + Varian).
    {"opcode": "0x9011", "name": "S_PET_CRYSTAL", "dir": "server", "sync": false,
     "fields": ["x:u8", {"name": "drops", "type": "repeat", "count": "x", "fields": ["colour:u8", "n:u32le"]}],
     "emit": {"event": "pet_crystal", "each": "drops", "when": "1", "colour": "colour", "amount": "n"}},
    // The game levelled a pet up by itself (its kills reached 5, 25 or 75):
    // 00 00, pet id, new level, more (not read). Comes right after the +1
    // that filled the bar, with 0x900e (pet id, the kills it took). Kills
    // start again at 0 (petfarm-test1-060-002: Slink 74 -> 75 -> Lv 3).
    {"opcode": "0x9014", "name": "S_PET_LEVEL_UP", "dir": "server", "sync": false,
     "fields": ["x:u16le", "pet:u32le", "level:u32le"],
     "emit": {"event": "pet", "when": "x==0", "pet": "pet", "level": "level", "count": "0", "up": "1"}},
    // A pet reached a goal: 01, pet id, the kills it took (5, 25, 75).
    // At 25 and 75 the level-up 0x9014 comes with it; unlocking at 5 sends
    // only this one (dunegon-test7-001: Sylphen, Ursus, Young Ursus kept
    // counting past 5 at Lv 0 until the next login list said Lv 1).
    {"opcode": "0x900e", "name": "S_PET_GOAL", "dir": "server", "sync": false,
     "fields": ["x:u8", "pet:u32le", "n:u32le"],
     "emit": {"event": "pet", "when": "x==1&&n==5", "pet": "pet", "level": "1", "count": "0", "up": "1"}},
    // You joined someone's dungeon room (8 zero bytes). The room announces
    // you with a 0x970b in the same moment, which names you on a fresh
    // install (r1792651601, report 1792823256).
    {"opcode": "0x9710", "name": "S_ROOM_ENTERED", "dir": "server",
     "fields": [],
     "emit": {"event": "room_entered", "when": "1"}},
    // Someone joined the dungeon room: one entry as in 0x9702 (status 0x0c,
    // slot, id...), sent the moment they join; the full list can come 40 s
    // later (rerun2 capture 2026-10-22).
    {"opcode": "0x970b", "name": "S_ROOM_JOINED", "dir": "server",
     "fields": [{"name": "members", "type": "member_names", "marker": 30, "header": 0}],
     "emit": {"event": "party_join", "when": "1", "members": "members"}},
    // A room member clicked Ready (1): their id, 0 0, server, flag.
    {"opcode": "0x9716", "name": "S_ROOM_READY", "dir": "server",
     "fields": ["id:u32le", "x:skip2", "server:u16le", "ready:u8"],
     "emit": {"event": "party_ready", "when": "1", "id": "id", "ready": "ready"}},
    // You clicked Ready (00 00 01); other members' clicks come as 0x9716.
    // 0 taken as Cancel Ready (not seen in a capture yet).
    {"opcode": "0x9715", "name": "S_ROOM_SELF_READY", "dir": "server",
     "fields": ["x:skip2", "ready:u8"],
     "emit": {"event": "self_ready", "when": "1", "ready": "ready"}},
    // The leader clicked Enter dungeon (no body); the teleport follows.
    {"opcode": "0x9319", "name": "S_ROOM_ENTER", "dir": "server",
     "fields": [],
     "emit": {"event": "party_entering", "when": "1"}},
    // You left an open-world party (no body, 3 s after "leave party").
    {"opcode": "0x9213", "name": "S_PARTY_LEAVE", "dir": "server",
     "fields": [],
     "emit": {"event": "party", "when": "1"}},
    // Force (several parties together at a field boss): every member, sent
    // when you join one (Watcher Kaira, capture 1793040837: 18 members at
    // 278 s, a new Force of 12 at 864 s). Entries: entity id, "$GUID",
    // member key, server, name, class number (see force_members).
    {"opcode": "0x9602", "name": "S_FORCE_INFO", "dir": "server",
     "fields": [{"name": "members", "type": "force_members"}],
     "emit": {"event": "force", "when": "1", "members": "members"}},
    // Someone joined your Force: one entry as in 0x9602 (10 in that capture,
    // matching the party joins at 883, 1089 and 1268 s).
    {"opcode": "0x960a", "name": "S_FORCE_JOINED", "dir": "server",
     "fields": [{"name": "members", "type": "force_members"}],
     "emit": {"event": "force_join", "when": "1", "members": "members"}},
    // Someone left your Force: their member key (BLCKSTR at 1195 s, the
    // moment the party list lost him).
    {"opcode": "0x9622", "name": "S_FORCE_LEFT", "dir": "server",
     "fields": ["key:u32le"],
     "emit": {"event": "force_leave", "when": "1", "key": "key"}},
    // The dungeon party is gone (no body): seen 2.5 s after "leave party",
    // about a minute after a run's last boss, and at a rerun. Also every
    // minute or two in an open-world party while gathering, with the party
    // still there (2026-10-28), so the engine only acts on it for a dungeon
    // party (party_gone).
    {"opcode": "0x8d3f", "name": "S_PARTY_LEFT", "dir": "server",
     "fields": [],
     "emit": {"event": "party_gone", "when": "1"}},
    // You were removed from a dungeon room (kicked while queueing; no body,
    // the room browser list 0x9701 follows). Seen twice in one capture, no
    // party list after it, so the old room stayed up. Not "party": that
    // would ignore the next room's titled list.
    {"opcode": "0x972a", "name": "S_ROOM_REMOVED", "dir": "server",
     "fields": [],
     "emit": {"event": "room_left", "when": "1"}},
    // You left the dungeon room (no body). In the waiting room nothing else
    // follows, so the old room stayed up; on a dungeon exit 0x971b comes
    // 0.05 s later, and the engine only empties the panel outside a dungeon.
    {"opcode": "0x971d", "name": "S_ROOM_EXIT", "dir": "server",
     "fields": [],
     "emit": {"event": "room_exit", "when": "1"}},
    // You left the dungeon: the room closes for you (u32 room id, the same
    // as in the 0x9702 header). With 0x971d just before it you left the
    // party too (test15 2026-10-26); the engine then empties the panel, and
    // a party that did stay comes back with its next list.
    {"opcode": "0x971b", "name": "S_ROOM_CLOSED", "dir": "server",
     "fields": [],
     "emit": {"event": "dungeon_left", "when": "1"}},
    // Stat update. kind 2 = HP (u32), kind 1 = MP.
    {"opcode": "0x8d00", "name": "S_STAT_UPDATE", "dir": "server",
     // (Kept free of "&&" so the file also loads in meter v0.1.0/0.1.1.)
     "fields": ["id:varint", "kind:u8", "a:u8", "b:u8",
                {"name": "hp", "type": "u32le", "if": "kind==2"},
                {"name": "val", "type": "u32le", "if": "kind!=2"}],
     "emit": [
       {"event": "hp", "when": "kind==2", "id": "id", "hp": "hp"},
       {"event": "death", "when": "hp==0", "target": "id"}
     ]}
  ]
}
