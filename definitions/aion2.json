// AION 2 protocol definitions for Daeva Meter.
//
// STATUS: framing and messages are NOT decoded yet. Fill this in from
// research captures (see docs/DECODING.md). The meter reloads this file
// from %APPDATA%\org.bajubesi.daevameter\definitions\ if present, so
// updates after a game patch never need a new build.
{
  "name": "AION 2 (global)",
  "version": "0.0.1-framing",
  "process_names": ["aion2"],
  // Server ports, if they turn out to be fixed. Auto-detection by process
  // already finds the server, so this can stay empty.
  "ports": [],
  "framing": {
    // Observed 2026-10-17 (Shulak cave capture): each server message is
    // <varint length><u16le opcode><body>, where the frame is (length - 3)
    // bytes long. e.g. "0e 00 36 aa 21 fd 47 a1 01 00 00" = 0x0e-3 = 11 bytes.
    "header": ["length:varint", "opcode:u16le"],
    "length_counts": "frame",
    "length_adjust": -3,
    "min_frame": 3,
    "max_frame": 1048576
  },
  "messages": [
    // Example of the shape a decoded damage packet will take:
    // {
    //   "opcode": "0x0000", "name": "S_ATTACK_RESULT", "dir": "server",
    //   "fields": ["src:varint", "tgt:varint", "skill:u32", "count:u8",
    //     {"name": "hits", "type": "repeat", "count": "count",
    //      "fields": ["dmg:varint", "flags:u16le"]}],
    //   "emit": {"event": "damage", "each": "hits", "src": "src", "tgt": "tgt",
    //            "skill": "skill", "amount": "dmg", "crit": "flags&0x1", "back": "flags&0x4"}
    // }
  ]
}
